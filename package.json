{
  "name": "luza",
  "version": "0.1.0",
  "private": true,
  "description": "LUZA - a cinematic futuristic AI desktop assistant for developers and creators.",
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:desktop": "npm --workspace @luza/desktop run dev",
    "dev:server": "npm --workspace @luza/server run dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
